# .env.example
APP_ENV=development
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=jeyshid
DB_PASSWORD=secret
DB_NAME=jeyshid
DB_SSL_MODE=disable

# JWT
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_32_chars
JWT_EXPIRY_HOURS=24

# Argon2id parameters (OWASP 2024 recommended for interactive logins)
ARGON2_MEMORY=19*1024    # 19 MiB
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_KEY_LENGTH=32
ARGON2_SALT_LENGTH=32

# Uploads
UPLOAD_PATH=./uploads/projects
MAX_UPLOAD_SIZE_MB=10